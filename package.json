{
  "name": "dangote-cms",
  "version": "1.0.0",
  "description": "Canteen Management System for Dangote",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "jest",
    "migrate:worker-identifier": "node scripts/migrate-worker-identifiers.js",
    "migrate:vendor-operator-field": "node scripts/migrate-vendor-operator-field.js",
    "verify:vendor-operator-field": "node scripts/verify-vendor-operator-migration.js",
    "seed:nonprod": "node scripts/seed-nonprod.js",
    "deploy:fly": "flyctl deploy --config fly.toml",
    "deploy:fly:logs": "flyctl logs --config fly.toml",
    "deploy:fly:frontend": "flyctl deploy --config fly.frontend.toml",
    "deploy:fly:frontend:logs": "flyctl logs --config fly.frontend.toml"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.17.3",
    "jsqr": "^1.4.0",
    "mongoose": "^9.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
