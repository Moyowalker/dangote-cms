# Copy this file to .env and set your values
SESSION_SECRET=your-secret-key-here
MONGO_URI=mongodb://localhost:27017/dangote-cms
PORT=3001
QR_TOKEN_SECRET=replace-with-random-hmac-secret
DUPLICATE_WINDOW_MINUTES=2
SESSION_COOKIE_SAME_SITE=strict
CSRF_COOKIE_SAME_SITE=strict

# Optional bootstrap + non-prod tooling
ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-admin-password
SEED_DEFAULT_PASSWORD=replace-with-strong-seed-password
CORS_ORIGINS=http://localhost:5173
LEGACY_STAFF_ID_FALLBACK_ENABLED=true
LEGACY_STATIC_UI_ENABLED=true
